<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath/>
	</parent>

	<groupId>cl.sportmedics</groupId>
	<artifactId>sportmedics-maven</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>sportmedics-maven</name>
	<description>Proyecto Padre para Microservicios Sportmedics</description>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2025.0.2</spring-cloud.version>
	</properties>

	<modules>
		<module>api-gateway</module>
		<module>ms-access</module>
		<module>ms-auth</module>
		<module>ms-billing</module>
		<module>ms-employee</module>
		<module>ms-inventory</module>
		<module>ms-member</module>
		<module>ms-notification</module>
		<module>ms-scheduling</module>
		<module>ms-subscription</module>
		<module>ms-workout</module>
		<module>service-registry</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
